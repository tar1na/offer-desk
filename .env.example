# Pipedrive API token: Pipedrive → Personal preferences → API
PIPEDRIVE_API_KEY=

# Any OpenAI-compatible endpoint (OpenAI itself, or a router/proxy)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: models tried in order; the next one is used if a model is slow to start answering
OPENAI_MODELS=gpt-6-luna,gpt-5.4,gpt-5.4-mini
OPENAI_FIRST_TOKEN_MS=15000
