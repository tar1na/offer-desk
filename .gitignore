# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local; .env.example is the template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
/data

# Claude Code local settings
/.claude/settings.local.json

# Impeccable working files (local caches, review captures, decision sketches)
/.impeccable/config.local.json
/.impeccable/hook.cache.json
/.impeccable/questions/
/.impeccable/review/
/.impeccable/mocks/
/.impeccable/build/
